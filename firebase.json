{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "!/assets/pdfs/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/pdfs/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/pdf"
          },
          {
            "key": "Content-Disposition",
            "value": "inline"
          }
        ]
      }
    ]
  }
}
